# NoWatermark requires ZERO secrets to build or run.
#
# The core application has no backend, no database and no object storage. Files
# are read, inspected and cleaned entirely in the browser and are never
# transmitted. Nothing in this file is needed for `pnpm dev` or `pnpm build` —
# it documents the optional, additive integrations.
#
# NOTE ON THE CSP: the Content-Security-Policy is generated by Astro from
# `security.csp` in astro.config.ts. It is NOT in public/_headers. Adding a
# third-party script means editing astro.config.ts and then checking the
# console on the deployed URL — a CSP failure is silent in the UI and has
# already caused two production outages here.

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------

# Cloudflare Web Analytics beacon token.
# Traffic and Core Web Vitals only — Cloudflare Web Analytics has no custom
# events API, so the funnel events are sent through GA4 instead.
# If this is unset, no beacon is loaded and every tool works normally.
PUBLIC_CF_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------
# Text rewriting (optional, off by default)
# ---------------------------------------------------------------------------
#
# The one feature that sends anything over the network, and only pasted text,
# only on explicit per-use opt-in. It fails closed in every partial state, so
# there is no unsafe ordering: set all three or none.
#
# Set the two secrets in the Cloudflare Pages dashboard, never in a file.

# Google Gemini API key (SECRET — server-side only, never in client JS).
# Without it, /api/rewrite returns 503.
# Must be a PAID-tier key. On the paid tier Google does not use prompts or
# responses for training and retains them ~55 days for abuse detection only.
# Dropping to the unpaid tier reverses both, and /privacy, /methodology and the
# consent panel all state the paid terms — so the tier is a privacy commitment,
# not a billing detail.
GEMINI_API_KEY=

# Cloudflare Turnstile secret (SECRET — server-side only).
# Without it, /api/rewrite returns 503 EVEN IF the Gemini key is present. An
# endpoint that spends the API key with no bot check must never run; this is
# enforced in code, not by convention.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key (public, build-time).
# Without it the rewrite UI is not merely hidden — it is tree-shaken out of the
# bundle entirely. Verify with: grep -rl "Rewrite with Gemini" dist/
PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Rate limiting — two steps that are NOT environment variables
# ---------------------------------------------------------------------------
#
# 1. KV NAMESPACE (dashboard, strongly recommended)
#
#    Create a KV namespace and bind it to this Pages project under the name
#    REWRITE_LIMITS. Without it the limiter still runs, but only per isolate:
#    Cloudflare runs many, so a determined caller spread across them gets
#    proportionally more than the stated limit. It narrows the hole; it does not
#    close it. GET /api/rewrite reports which tier is active.
#
#    Current limits live in functions/api/_rate-limit.ts (RULES).
#
# 2. GOOGLE-SIDE BUDGET CAP (Google Cloud console, required)
#
#    Rate limiting bounds requests, not spend. A budget cap is the only thing
#    that bounds the bill if something gets through, and it cannot be set from
#    this repository. In the Google Cloud project holding GEMINI_API_KEY:
#      - Billing > Budgets & alerts > create a budget with email alerts
#      - APIs & Services > Credentials > restrict the key to the Generative
#        Language API, and add an HTTP referrer or IP restriction
#      - Quotas > set a per-day request cap on the Generative Language API
#
#    Until that is done, the only limit on a compromised key is Google's
#    default quota, which is not a budget.

# ---------------------------------------------------------------------------
# Advertising (optional, not enabled)
# ---------------------------------------------------------------------------

# Google AdSense publisher ID.
# Ad slots render nothing until this is set AND AdSlot.astro's ADS_ENABLED flag
# is turned on. Enabling ads also requires adding AdSense to `security.csp` in
# astro.config.ts (see the note at the top), and updating /privacy in the same
# commit.
PUBLIC_ADSENSE_CLIENT_ID=
