# NoWatermark requires ZERO secrets to build or run.
#
# The core application has no backend, no database, no object storage and no
# external API. Nothing in this file is needed for `pnpm dev` or `pnpm build`
# to work — it exists to document the optional, additive integrations.

# Cloudflare Web Analytics beacon token (optional).
# Traffic and Core Web Vitals only — Cloudflare Web Analytics has no custom
# events API, so the funnel events in the PRD cannot be recorded with it.
# If this is unset, no analytics script is loaded and every tool works normally.
PUBLIC_CF_ANALYTICS_TOKEN=

# Google AdSense publisher ID (optional, not enabled at launch).
# Ad slots render nothing until this is set AND AdSlot.astro's ADS_ENABLED flag
# is turned on. Enabling ads also requires loosening the CSP in public/_headers.
PUBLIC_ADSENSE_CLIENT_ID=
