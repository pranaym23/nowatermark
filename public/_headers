# Cloudflare Pages headers.
#
# The CSP is deliberately tight: this site loads no third-party script, makes no
# XHR/fetch calls, and never connects anywhere at runtime.
#
# When Cloudflare Web Analytics is enabled, add to script-src and connect-src:
#   https://static.cloudflareinsights.com
# Enabling AdSense later requires loosening this substantially — keep that
# change isolated to this file so it is reviewable in one diff (PRD §40).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; form-action 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og.svg
  Cache-Control: public, max-age=604800
