---
interface Item {
  href: string;
  label: string;
  blurb?: string;
}

interface Props {
  tools?: Item[];
  guides?: Item[];
}

const { tools = [], guides = [] } = Astro.props;
---

{
  (tools.length > 0 || guides.length > 0) && (
    <section class="mt-14 grid gap-8 md:grid-cols-2">
      {tools.length > 0 && (
        <div>
          <h2 class="text-lg font-semibold">Related tools</h2>
          <ul class="mt-3 space-y-2">
            {tools.map((item) => (
              <li>
                <a href={item.href} class="group block">
                  <span class="text-sm font-medium group-hover:underline">{item.label}</span>
                  {item.blurb && <span class="block text-xs nw-muted">{item.blurb}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {guides.length > 0 && (
        <div>
          <h2 class="text-lg font-semibold">Related guides</h2>
          <ul class="mt-3 space-y-2">
            {guides.map((item) => (
              <li>
                <a href={item.href} class="group block">
                  <span class="text-sm font-medium group-hover:underline">{item.label}</span>
                  {item.blurb && <span class="block text-xs nw-muted">{item.blurb}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}
