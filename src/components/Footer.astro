---
import { FOOTER_LEARN, FOOTER_SITE, FOOTER_TOOLS, SITE } from '../lib/site';

const year = new Date().getFullYear();
const columns = [
  { title: 'Tools', links: FOOTER_TOOLS },
  { title: 'Learn', links: FOOTER_LEARN },
  { title: SITE.name, links: FOOTER_SITE },
];
---

<footer class="mt-20 border-t-5" style="border-color: var(--nw-gutter);">
  <div class="nw-shell grid gap-8 py-12 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <p class="font-semibold">{SITE.name}</p>
      <p class="mt-1.5 text-sm nw-muted">{SITE.descriptor}</p>
      <p class="mt-4 text-sm nw-muted">
        Files are inspected in your browser and never uploaded.
      </p>
    </div>

    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="text-sm font-semibold">{column.title}</p>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm nw-muted hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="nw-shell border-t py-6 text-xs nw-muted" style="border-color: var(--nw-border);">
    <p>
      © {year} {SITE.name}. Results are provided without guarantees. The absence of a detected
      signal does not prove the absence of every watermark.
    </p>
  </div>
</footer>
