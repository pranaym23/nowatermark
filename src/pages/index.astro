---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import ImageScanner from '../components/react/ImageScanner';
import { FEATURED_TOOLS, SITE } from '../lib/site';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const title = 'AI Watermark Checker & Metadata Remover | NoWatermark';
const description =
  'Check images for AI provenance, C2PA, Content Credentials and hidden metadata. Remove supported metadata privately in your browser.';

const faq = [
  {
    q: 'Are my files uploaded?',
    a: 'No. Every scan and clean runs inside your browser. There is no upload endpoint and no storage. You can disconnect from the internet after the page loads and the tools keep working.',
  },
  {
    q: 'Can you remove SynthID?',
    a: 'No. SynthID is embedded in the pixels rather than the metadata, and no browser-based tool can detect it — which also means none can confirm removing it. We report it as "Unable to verify" on every image.',
  },
  {
    q: 'Does cleaning reduce image quality?',
    a: 'No. Metadata is removed at the container level and the compressed image data is copied byte-for-byte, so the pixels are identical afterwards.',
  },
  {
    q: 'Which formats are supported?',
    a: 'JPG, PNG and WebP for images, and any pasted text for the hidden-character tools. More formats may follow.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Every tool works without registration, and nothing is stored.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE.name,
    url: SITE.url,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" schema={schema}>
  <section class="nw-shell pt-12 pb-6 sm:pt-16">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold sm:text-4xl">AI Watermark &amp; Metadata Checker</h1>
      <p class="mt-3 text-lg nw-muted">
        See what AI and metadata fingerprints are hiding inside your files.
      </p>
    </div>

    <div class="mx-auto mt-8 max-w-2xl">
      <ImageScanner client:load />
    </div>
  </section>

  <AdSlot position="after-tool" />

  <section class="nw-shell mt-16">
    <h2 class="text-2xl font-semibold">What NoWatermark checks</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="nw-card p-5">
        <h3 class="font-semibold">AI provenance</h3>
        <p class="mt-2 text-sm nw-muted">
          C2PA manifests, Content Credentials and the generator tags AI tools leave behind —
          including the prompt and settings stored inside PNG files.
        </p>
      </div>
      <div class="nw-card p-5">
        <h3 class="font-semibold">Private metadata</h3>
        <p class="mt-2 text-sm nw-muted">
          GPS coordinates, camera and phone identifiers, timestamps, editing software and
          authorship fields — the data a photo carries without showing you.
        </p>
      </div>
      <div class="nw-card p-5">
        <h3 class="font-semibold">Hidden characters</h3>
        <p class="mt-2 text-sm nw-muted">
          Invisible Unicode, zero-width spaces and bidirectional controls that survive copy and
          paste, in both file metadata and pasted text.
        </p>
      </div>
    </div>
  </section>

  <section class="nw-shell mt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-semibold">Popular tools</h2>
      <a href="/tools" class="text-sm nw-muted hover:underline">All tools</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        FEATURED_TOOLS.map((tool) => (
          <a href={tool.slug} class="nw-card group p-5 transition-colors hover:border-[var(--nw-border-strong)]">
            <h3 class="font-semibold group-hover:underline">{tool.cardTitle}</h3>
            <p class="mt-1.5 text-sm nw-muted">{tool.cardBlurb}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="nw-shell mt-16">
    <div class="nw-card p-6 sm:p-8">
      <h2 class="text-2xl font-semibold">Your files stay yours</h2>
      <p class="mt-3 max-w-2xl text-sm nw-muted">
        NoWatermark has no upload endpoint, no database and no file storage. Your image is read
        from disk into your browser's memory, inspected there, cleaned there, and offered back to
        you as a local download. Nothing is transmitted at any point.
      </p>
      <p class="mt-3 max-w-2xl text-sm nw-muted">
        You do not have to take our word for it. Load this page, disconnect from the internet, then
        scan and clean a file. Everything works, because it was always working locally.
      </p>
      <p class="mt-4 text-sm font-medium">🔒 Processed locally in your browser</p>
    </div>
  </section>

  <section class="nw-shell mt-16">
    <h2 class="text-2xl font-semibold">Not every AI watermark works the same way</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <div>
        <h3 class="font-semibold">Metadata can be removed</h3>
        <p class="mt-2 text-sm nw-muted">
          EXIF, XMP, IPTC, PNG text chunks and C2PA manifests are records attached alongside the
          picture. They can be read, removed cleanly, and — crucially — the removal can be verified
          by scanning the result again. That is what our cleaners do.
        </p>
      </div>
      <div>
        <h3 class="font-semibold">Embedded signals cannot</h3>
        <p class="mt-2 text-sm nw-muted">
          SynthID and similar techniques encode a signal into the pixels themselves. Metadata
          cleaning never touches pixels, so it cannot affect them — and no browser tool can even
          detect them. We report those as <strong>Unable to verify</strong>, never as absent.
        </p>
      </div>
    </div>
    <p class="mt-5 text-sm">
      <a href="/guides/can-you-remove-ai-watermarks" class="underline"
        >Read: can you remove AI watermarks?</a
      >
    </p>
  </section>

  <section class="nw-shell mt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-semibold">Popular guides</h2>
      <a href="/guides" class="text-sm nw-muted hover:underline">All guides</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((guide) => (
          <a href={`/guides/${guide.id}`} class="nw-card group p-5">
            <h3 class="font-semibold group-hover:underline">{guide.data.title}</h3>
            <p class="mt-1.5 text-sm nw-muted">{guide.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <div class="nw-shell">
    <Faq items={faq} />
  </div>

  <div class="h-10"></div>
</BaseLayout>
