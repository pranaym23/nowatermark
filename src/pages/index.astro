---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import ScannerTabs from '../components/react/ScannerTabs';
import { FEATURED_TOOLS, SITE } from '../lib/site';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const title = 'AI Watermark Checker & Metadata Remover | NoWatermark';
const description =
  'Check images for AI provenance, C2PA and hidden metadata, or scan text for invisible Unicode characters. File processing runs privately in your browser - nothing is uploaded.';

const faq = [
  {
    q: 'Are my files uploaded?',
    a: 'No. Every file scan and clean runs inside your browser. There is no upload endpoint and no storage. You can disconnect from the internet after the page loads and the file tools keep working. The one feature that sends anything is the optional text rewrite, which asks first and shows you exactly what it will send.',
  },
  {
    q: 'Can you remove SynthID?',
    a: 'No. SynthID is embedded in the pixels rather than the metadata, and no browser-based tool can detect it — which also means none can confirm removing it. We report it as "Unable to verify" on every image.',
  },
  {
    q: 'Does cleaning reduce image quality?',
    a: 'No. Metadata is removed at the container level and the compressed image data is copied byte-for-byte, so the pixels are identical afterwards.',
  },
  {
    q: 'What does the text checker find?',
    a: 'Invisible Unicode - zero-width spaces, bidirectional controls and Unicode tag characters that survive copy and paste. It deliberately preserves the zero-width joiners and variation selectors that emoji need, so cleaning does not break them. It does not detect statistical AI-text watermarks, and no browser-based tool can.',
  },
  {
    q: 'Which formats are supported?',
    a: 'We scan JPG, PNG, WebP, SVG, Markdown and PDF, and clean all of them except PDF — PDF inspection is available now, with removal still to come. Pasted text is also supported for the hidden-character tools. In an SVG, images embedded inside the file are cleaned too.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Every tool works without registration, and nothing is stored.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE.name,
    url: SITE.url,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" schema={schema}>
  <section class="nw-shell pt-8 sm:pt-12">
    <div class="nw-panel-grid grid-cols-1 md:grid-cols-[1.1fr_.9fr]">
      <div class="nw-panel nw-tone flex min-h-80 flex-col justify-between">
        <div>
          <p class="nw-panel-label">Publish-ready check</p>
          <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">Every file is hiding something.</h1>
          <p class="mt-4 max-w-xl text-lg nw-muted">
            Make an image, document or piece of text ready to publish: see what it reveals about
            you and what it declares about how it was made, then remove what can be removed.
          </p>

          {/*
            R30 wants the strongest proof beside the promise, not eight screens
            below it. Three claims, each one checkable: the first by watching
            the network panel, the second and third by test.
          */}
          <ul class="nw-proof mt-6">
            <li><strong>Nothing is uploaded.</strong> There is no upload endpoint.</li>
            <li><strong>Nothing is re-encoded.</strong> Image quality is untouched.</li>
            <li><strong>Removal is re-scanned</strong> before we call it removed.</li>
          </ul>
        </div>
        <span class="nw-stamp self-start">Case open</span>
      </div>
      <div class="nw-panel flex items-start">
        <ScannerTabs client:load />
      </div>
    </div>
  </section>

  <AdSlot position="after-tool" />

  <section class="nw-shell mt-16">
    <h2 class="text-2xl font-semibold">What NoWatermark checks</h2>
    <div class="nw-panel-grid mt-6 grid-cols-1 md:grid-cols-3">
      <div class="nw-panel">
        <h3 class="font-semibold">AI provenance</h3>
        <p class="mt-2 text-sm nw-muted">
          C2PA manifests, Content Credentials and the generator tags AI tools leave behind —
          including the prompt and settings stored inside PNG files.
        </p>
      </div>
      <div class="nw-panel">
        <h3 class="font-semibold">Private metadata</h3>
        <p class="mt-2 text-sm nw-muted">
          GPS coordinates, camera and phone identifiers, timestamps, editing software and
          authorship fields — the data a photo carries without showing you.
        </p>
      </div>
      <div class="nw-panel">
        <h3 class="font-semibold">Hidden characters</h3>
        <p class="mt-2 text-sm nw-muted">
          Invisible Unicode, zero-width spaces and bidirectional controls that survive copy and
          paste, in both file metadata and pasted text.
        </p>
      </div>
    </div>
  </section>

  <section class="nw-shell mt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-semibold">Popular tools</h2>
      <a href="/tools" class="text-sm nw-muted hover:underline">All tools</a>
    </div>
    <div class="nw-panel-grid mt-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        FEATURED_TOOLS.map((tool) => (
          <a href={tool.slug} class="nw-panel group transition-colors">
            <h3 class="font-semibold group-hover:underline">{tool.cardTitle}</h3>
            <p class="mt-1.5 text-sm nw-muted">{tool.cardBlurb}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="nw-shell mt-16">
    <div class="nw-panel p-6 sm:p-8">
      <h2 class="text-2xl font-semibold">Your files stay yours</h2>
      <p class="mt-3 max-w-2xl text-sm nw-muted">
        NoWatermark has no upload endpoint, no database and no file storage. Your image is read
        from disk into your browser's memory, inspected there, cleaned there, and offered back to
        you as a local download. No file is transmitted at any point. The one thing this site can
        send is text you paste, and only if you press the rewrite button and confirm what is sent —
        see our <a href="/privacy" class="underline">privacy page</a>.
      </p>
      <p class="mt-3 max-w-2xl text-sm nw-muted">
        You do not have to take our word for it. Load this page, disconnect from the internet, then
        scan and clean a file. Everything works, because it was always working locally.
      </p>
      <p class="mt-4 text-sm font-medium">🔒 Processed locally in your browser</p>
    </div>
  </section>

  <section class="nw-shell mt-16">
    <h2 class="text-2xl font-semibold">Not every AI watermark works the same way</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      <div>
        <h3 class="font-semibold">Metadata can be removed</h3>
        <p class="mt-2 text-sm nw-muted">
          EXIF, XMP, IPTC, PNG text chunks and C2PA manifests are records attached alongside the
          picture. They can be read, removed cleanly, and — crucially — the removal can be verified
          by scanning the result again. That is what our cleaners do.
        </p>
      </div>
      <div>
        <h3 class="font-semibold">Embedded signals cannot</h3>
        <p class="mt-2 text-sm nw-muted">
          SynthID and similar techniques encode a signal into the pixels themselves. Metadata
          cleaning never touches pixels, so it cannot affect them — and no browser tool can even
          detect them. We report those as <strong>Unable to verify</strong>, never as absent.
        </p>
      </div>
    </div>
    <p class="mt-5 text-sm">
      <a href="/guides/can-you-remove-ai-watermarks" class="underline"
        >Read: can you remove AI watermarks?</a
      >
    </p>
  </section>

  <section class="nw-shell mt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-semibold">Popular guides</h2>
      <a href="/guides" class="text-sm nw-muted hover:underline">All guides</a>
    </div>
    <div class="nw-panel-grid mt-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((guide) => (
          <a href={`/guides/${guide.id}`} class="nw-panel group">
            <h3 class="font-semibold group-hover:underline">{guide.data.title}</h3>
            <p class="mt-1.5 text-sm nw-muted">{guide.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <div class="nw-shell">
    <Faq items={faq} />
  </div>

  <div class="h-10"></div>
</BaseLayout>
