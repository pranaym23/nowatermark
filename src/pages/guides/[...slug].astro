---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { SITE, toolBySlug } from '../../lib/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const allGuides = await getCollection('guides');
const guideByPath = new Map(allGuides.map((g) => [`/guides/${g.id}`, g]));

const path = `/guides/${guide.id}`;
const title = guide.data.metaTitle ?? `${guide.data.title} | ${SITE.name}`;

const relatedTools = guide.data.relatedTools
  .map((s) => toolBySlug(s))
  .filter((t) => t !== undefined)
  .map((t) => ({ href: t.slug, label: t.cardTitle, blurb: t.cardBlurb }));

const relatedGuides = guide.data.relatedGuides
  .map((p) => guideByPath.get(p))
  .filter((g) => g !== undefined)
  .map((g) => ({ href: `/guides/${g.id}`, label: g.data.title, blurb: g.data.summary }));

const isoDate = (value: Date) => value.toISOString();
// Frontmatter dates are plain calendar days parsed as UTC midnight. Format in
// UTC too, or a build machine west of Greenwich renders the previous day.
const readable = (value: Date) =>
  value.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const schema: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: isoDate(guide.data.publishDate),
    dateModified: isoDate(guide.data.updatedDate ?? guide.data.publishDate),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: guide.data.title, item: new URL(path, SITE.url).href },
    ],
  },
];

if (guide.data.faq.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.data.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={guide.data.description}
  canonicalPath={path}
  schema={schema}
>
  <article class="nw-shell-narrow pt-8">
    <Breadcrumbs
      trail={[{ href: '/guides', label: 'Guides' }, { href: path, label: guide.data.title }]}
    />

    <header class="nw-panel nw-calm-header mt-6">
      <h1 class="text-3xl font-bold">{guide.data.title}</h1>
      <p class="mt-3 text-lg nw-muted">{guide.data.description}</p>
      <p class="mt-3 text-xs nw-muted">
        Published <time datetime={isoDate(guide.data.publishDate)}>{readable(guide.data.publishDate)}</time>
        {
          guide.data.updatedDate && (
            <>
              {' · Updated '}
              <time datetime={isoDate(guide.data.updatedDate)}>{readable(guide.data.updatedDate)}</time>
            </>
          )
        }
      </p>
    </header>

    <div class="nw-content mt-8">
      <Content />
    </div>

    <AdSlot position="article-end" />

    <div>
      <Faq items={guide.data.faq} />
      <RelatedLinks tools={relatedTools} guides={relatedGuides} />
    </div>
  </article>

  <div class="h-10"></div>
</BaseLayout>
