---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

/*
 * Only types that change what the reader should expect get a badge. A plain
 * guide gets none — labelling the default adds noise without adding meaning.
 */
const TYPE_LABEL: Partial<Record<string, string>> = {
  lab: 'Lab report',
  comparison: 'Comparison',
  answer: 'Quick answer',
};

const readable = (value: Date) =>
  value.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const title = 'Guides — AI Watermarks, Provenance and Metadata | NoWatermark';
const description =
  'Plain explanations of SynthID, C2PA, Content Credentials, EXIF and AI image metadata — including what can and cannot be removed.';
---

<BaseLayout title={title} description={description} canonicalPath="/guides">
  <div class="nw-shell pt-8">
    <Breadcrumbs trail={[{ href: '/guides', label: 'Guides' }]} />

    <header class="nw-panel nw-calm-header nw-prose mt-6">
      <h1 class="text-3xl font-bold">Guides</h1>
      <p class="mt-3 text-lg nw-muted">
        How AI provenance actually works — what each technology does, where it is stored, and what
        that means for what you can remove.
      </p>
    </header>

    <div class="nw-panel-grid mt-10 grid-cols-1 sm:grid-cols-2">
      {
        guides.map((guide) => (
          <a href={`/guides/${guide.id}`} class="nw-panel group">
            {TYPE_LABEL[guide.data.contentType] && (
              <span class="nw-panel-label block">{TYPE_LABEL[guide.data.contentType]}</span>
            )}
            <h2 class="mt-1 font-semibold group-hover:underline">{guide.data.title}</h2>
            <p class="mt-1.5 text-sm nw-muted">{guide.data.summary}</p>
            {guide.data.lastTested && (
              <p class="mt-2 text-xs nw-muted">
                Last tested{' '}
                <time datetime={guide.data.lastTested.toISOString()}>
                  {readable(guide.data.lastTested)}
                </time>
              </p>
            )}
          </a>
        ))
      }
    </div>
  </div>

  <div class="h-16"></div>
</BaseLayout>
