---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { TOOLS } from '../lib/site';

const title = 'All Tools — Metadata and AI Provenance Utilities | NoWatermark';
const description =
  'Every NoWatermark tool: AI watermark checkers and removers, C2PA and Content Credentials, SynthID, EXIF and hidden-character utilities. All free and browser-based.';

const imageTools = TOOLS.filter((t) => t.tool === 'image');
const textTools = TOOLS.filter((t) => t.tool === 'text');
---

<BaseLayout title={title} description={description} canonicalPath="/tools">
  <div class="nw-shell pt-8">
    <Breadcrumbs trail={[{ href: '/tools', label: 'Tools' }]} />

    <header class="nw-prose mt-6">
      <h1 class="text-3xl font-bold">All tools</h1>
      <p class="mt-3 text-lg nw-muted">
        Every tool runs in your browser. Nothing is uploaded, and no tool requires an account.
      </p>
    </header>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Image tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          imageTools.map((tool) => (
            <a href={tool.slug} class="nw-card group p-5">
              <h3 class="font-semibold group-hover:underline">{tool.cardTitle}</h3>
              <p class="mt-1.5 text-sm nw-muted">{tool.cardBlurb}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold">Text tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          textTools.map((tool) => (
            <a href={tool.slug} class="nw-card group p-5">
              <h3 class="font-semibold group-hover:underline">{tool.cardTitle}</h3>
              <p class="mt-1.5 text-sm nw-muted">{tool.cardBlurb}</p>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <div class="h-16"></div>
</BaseLayout>
