---
/**
 * The versioned capability matrix (V2 R17).
 *
 * /methodology explains *how* the product works. This page answers a narrower
 * question that content pages need to link to constantly: as of a specific
 * date, which formats are opened, which parts of them are read, which signals
 * come out, and what is known not to work.
 *
 * Everything here is rendered from `src/lib/formats.ts` and `src/lib/signals.ts`.
 * There is no hand-written capability claim on this page, so it cannot drift
 * from the engine — which is the only reason it is safe to cite.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { FORMATS, FORMAT_COVERAGE, type CleanableFormat } from '../lib/formats';
import {
  CAPABILITY_UPDATED,
  CAPABILITY_VERSION,
  SIGNAL_LIST,
  VALIDATION_NOTES,
  type SignalCategory,
} from '../lib/signals';
import { SITE } from '../lib/site';

const title = `Capability Matrix v${CAPABILITY_VERSION} — What NoWatermark Supports | NoWatermark`;
const description =
  'A dated, versioned record of every file format NoWatermark opens, which parts of each container it reads, which signals it can remove and verify, and what it cannot measure at all.';

const formatRows = (Object.keys(FORMATS) as CleanableFormat[]).map((key) => ({
  key,
  spec: FORMATS[key],
  coverage: FORMAT_COVERAGE[key],
}));

const CATEGORY_LABEL: Record<SignalCategory, string> = {
  provenance: 'Provenance',
  metadata: 'Metadata',
  privacy: 'Privacy',
  hidden: 'Hidden text',
};

const categories = (Object.keys(CATEGORY_LABEL) as SignalCategory[])
  .map((category) => ({
    category,
    label: CATEGORY_LABEL[category],
    signals: SIGNAL_LIST.filter((s) => s.category === category),
  }))
  .filter((group) => group.signals.length > 0);

/*
 * The four-way classification (R2). "Detected but not removable" and "cannot be
 * measured at all" are different statements, and collapsing them is the failure
 * mode this whole page exists to prevent.
 */
function verdict(s: { detect: boolean; remove: boolean; verify: boolean }): {
  label: string;
  tone: 'ok' | 'partial' | 'no' | 'void';
} {
  if (!s.detect) return { label: 'Unable to verify', tone: 'void' };
  if (s.remove && s.verify) return { label: 'Removed and verified', tone: 'ok' };
  if (s.remove) return { label: 'Removed, not verified', tone: 'partial' };
  return { label: 'Detected only', tone: 'no' };
}

const support = (level: string) =>
  level === 'clean' ? 'Inspect and clean' : level === 'scan' ? 'Inspect only' : 'Not supported';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `NoWatermark capability matrix v${CAPABILITY_VERSION}`,
    description,
    version: CAPABILITY_VERSION,
    dateModified: CAPABILITY_UPDATED,
    creator: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    url: new URL('/capabilities', SITE.url).href,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/capabilities"
  schema={schema}
>
  <div class="nw-shell-narrow pt-8">
    <Breadcrumbs trail={[{ href: '/capabilities', label: 'Capabilities' }]} />

    <header class="nw-panel nw-calm-header mt-6">
      <h1 class="text-3xl font-bold">Capability matrix</h1>
      <p class="mt-3 text-lg nw-muted">
        Every format this tool opens, every signal it can and cannot act on, and the date each
        claim was last checked.
      </p>
      <p class="nw-last-tested mt-4 text-xs">
        Version {CAPABILITY_VERSION} · Last updated <time datetime={CAPABILITY_UPDATED}>{CAPABILITY_UPDATED}</time>.
        This page is generated from the same configuration the scanner and cleaners read, so it
        cannot describe a capability the code does not have.
      </p>
    </header>

    <div class="nw-content mt-10">
      <h2>Formats</h2>
      <p>
        “Supported” on its own is not a useful claim, so each row also states which parts of the
        container are opened and what is left uncovered.
      </p>
    </div>

    <div class="mt-4 grid gap-5">
      {
        formatRows.map(({ key, spec, coverage }) => (
          <section class="nw-evidence-panel p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold">{spec.label}</h3>
              <span class="nw-status px-2 py-1" style={`background-color: ${spec.support === 'clean' ? 'var(--nw-ok-soft)' : 'var(--nw-spot-soft)'};`}>
                {support(spec.support)}
              </span>
            </div>
            <p class="mt-1 text-xs nw-muted">
              {spec.mime} · .{spec.extension} · {spec.kind}
            </p>

            <h4 class="nw-panel-label mt-4">Inspected</h4>
            <ul class="mt-1.5 space-y-1 text-sm">
              {coverage.inspects.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <h4 class="nw-panel-label mt-4">Not covered</h4>
            <ul class="mt-1.5 space-y-1 text-sm nw-muted">
              {coverage.limits.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="nw-content mt-12">
      <h2>Signals</h2>
      <p>
        Four outcomes, and the difference between the last two is the entire point of this
        product. <strong>Detected only</strong> means the signal is there and we will tell you, but
        we cannot take it out. <strong>Unable to verify</strong> means we cannot determine whether
        it is present at all — it is not a “no”, and it will never become one.
      </p>
    </div>

    {
      categories.map((group) => (
        <section class="mt-8">
          <h3 class="text-lg font-semibold">{group.label}</h3>
          <div class="mt-3 grid gap-4">
            {group.signals.map((signal) => {
              const v = verdict(signal);
              return (
                <div class={`nw-evidence-panel p-4${v.tone === 'void' ? ' nw-evidence-panel--void' : ''}`}>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <span class="font-medium">{signal.label}</span>
                    <span class="nw-status">{v.label}</span>
                  </div>
                  <p class="mt-1.5 text-sm" style="color: var(--nw-evidence-muted);">
                    {signal.description}
                  </p>
                </div>
              );
            })}
          </div>
        </section>
      ))
    }

    <div class="nw-content mt-12">
      <h2>What backs these claims</h2>
      <p>
        A capability table is only worth as much as the checking behind it. These are the
        validations the current version rests on.
      </p>
    </div>

    <div class="mt-4 grid gap-4">
      {
        VALIDATION_NOTES.map((note) => (
          <div class="nw-evidence-panel p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-medium">{note.subject}</span>
              <time datetime={note.date} class="text-xs nw-muted">
                {note.date}
              </time>
            </div>
            <p class="mt-1.5 text-sm nw-muted">{note.summary}</p>
          </div>
        ))
      }
    </div>

    <div class="nw-content mt-12">
      <h2>Standing limits</h2>
      <p>
        These are not gaps waiting to be closed in a later release. They are consequences of where
        the processing happens.
      </p>
      <ul>
        <li>
          <strong>Pixel and statistical watermarks cannot be measured.</strong> SynthID and
          statistical text watermarks are detected by systems the model providers hold. A tool
          running on your device cannot confirm their presence or their absence, so it reports
          neither.
        </li>
        <li>
          <strong>Server-side provenance is out of reach.</strong> A service can re-associate a
          file with its records using a perceptual fingerprint held in its own database. Removing
          everything inside the file does not affect that, and nothing local can.
        </li>
        <li>
          <strong>C2PA signatures are not cryptographically verified.</strong> A manifest is
          reported as present, never as valid or invalid.
        </li>
        <li>
          <strong>Removal is only claimed after a re-scan.</strong> The cleaned output is scanned
          again by the same engine and diffed against the original. A cleaner reporting its own
          success is not evidence.
        </li>
        <li>
          <strong>Nothing is recompressed.</strong> Cleaners rewrite the container and copy the
          compressed image data byte for byte, so cleaning never costs image quality.
        </li>
      </ul>

      <p class="mt-6">
        For how any of this works, see the <a href="/methodology">methodology</a>. For what leaves
        your device — which is nothing, unless you explicitly opt into text rewriting — see the
        <a href="/privacy">privacy page</a>.
      </p>
    </div>
  </div>

  <div class="h-10"></div>
</BaseLayout>
